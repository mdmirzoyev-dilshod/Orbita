# Railway подставляет DATABASE_URL сам, когда вы добавите PostgreSQL и свяжете его с сервисом
DATABASE_URL=postgres://user:password@host:5432/railway
# Токен бота от @BotFather — вставьте в Railway → Variables, не публикуйте
BOT_TOKEN=
# Адрес сайта (Railway подставит RAILWAY_PUBLIC_DOMAIN сам; укажите, если подключите свой домен)
APP_URL=
# Часовой пояс для сводок и сроков
APP_TZ=Asia/Tashkent
# Тестовый вход без Telegram — только для проверки, на рабочем сервере не включать
DEV_LOGIN=0

# ИИ для бота: голосовые → текст, свободный текст → задачи/расходы/комментарии (OpenAI или совместимый API)
OPENAI_API_KEY=
# AI_MODEL=gpt-4o-mini
# AI_STT_MODEL=whisper-1
# AI_BASE_URL=https://api.openai.com/v1

# Тарифы
# PRICE_UZS=12000            # цена одной единицы ($1) в сумах: работник, «Мои планы», «Кошелёк»; ИИ-помощник = 2 единицы
# PAY_CONTACT=@username      # куда писать для оплаты — показывается клиентам
# PLATFORM_ADMINS=@username  # кто видит «Админку» (Telegram @username или id через запятую)

# Онлайн-оплата по QR (после договора с платёжной системой)
# PAYME_MERCHANT_ID=          # ID кассы в кабинете Payme Business
# PAYME_KEY=                  # ключ кассы (для песочницы — тестовый ключ)
# PAYME_TEST=1                # 1 — песочница checkout.test.paycom.uz
#   В кабинете Payme: endpoint = https://<домен>/pay/payme, поле счёта = order_id
# CLICK_SERVICE_ID=
# CLICK_MERCHANT_ID=
# CLICK_SECRET_KEY=
#   В кабинете Click: Prepare URL = https://<домен>/pay/click/prepare, Complete URL = https://<домен>/pay/click/complete

# Джарвис — личный ИИ-помощник владельца: вход /api/jarvis/* по ключу (не короче 24 символов)
# JARVIS_API_KEY=
# JARVIS_USER=@username   # от чьего имени ставит задачи (по умолчанию — администратор платформы)
